  <book code="MRK" style="id"/>
  <para style="imt1">The Gospel of Mark<note style="f" caller="+"> <char style="fr" closed="false">0.0 </char><char style="ft" closed="false">Also called the Gospel according to Mark.</char></note>
</para>
  <para style="is1">Introduction<note style="fe" caller="+"> <char style="ft" closed="false">See the endnotes.</char></note>
</para>
  <para style="ip">The Gospel of Mark<note style="f" caller="+"> <char style="fr" closed="false">0.1 </char><char style="fq" closed="false">Gospel </char><char style="ft" closed="false">means good news.</char></note> begins with <char style="iqt" closed="true">the beginning<note style="f" caller="+"> <char style="ft" closed="false">Some manuscripts add more.</char></note> of the good news</char>.
</para>
  <para style="io1">The beginning<note style="ef" caller="-"> <char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Study note.</char></note> <char style="ior" closed="true">1.1-13<note style="f" caller="+"> <char style="ft" closed="false">Or 1.1-15.</char></note></char></para>
  <para style="ili1">The Messiah<note style="efe" caller="+"> <char style="ft" closed="false">Extended study endnote.</char></note> is the one promised by God.
</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="p"><verse number="1" style="v" sid="MRK 1:1"/>The beginning of the good news.
<verse eid="MRK 1:1"/></para>
  <chapter eid="MRK 1"/>
